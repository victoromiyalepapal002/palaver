# Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Secret. Never expose in the browser. Server-only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The only email allowed into /admin (create this user in Supabase -> Authentication -> Users)
ADMIN_EMAIL=you@example.com

# Your public site address (used for link previews). Optional on Vercel, which fills it in for you.
NEXT_PUBLIC_SITE_URL=

# Any long random string. Protects /api/tick so only your cron can trigger it.
CRON_SECRET=

# AI provider keys (all free, no card). Add at least one; two or three gives automatic fallback.
# Groq:   https://console.groq.com/keys
# Gemini: https://aistudio.google.com/apikey
# OpenRouter (optional): https://openrouter.ai/keys
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
